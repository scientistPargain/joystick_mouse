# ==========================================
# Python & Virtual Environment `.gitignore`
# ==========================================

# Ignore the virtual environment directory completely
venv/
.venv/
env/
ENV/

# Byte-compiled / optimized / DLL files (Python caches)
__pycache__/
*.pyc
*.pyo
*.pyd

# Distribution / packaging logs
*.log
pip-log.txt
pip-delete-this-directory.txt

# ==========================================
# PlatformIO & Embedded `.gitignore`
# ==========================================

# Ignore build artifacts, compiled binaries, and temporary storage
.pio/
.pioenvs/
.piolibdeps/

# Ignore local VS Code / PlatformIO workspace configurations
.vscode/.project
.vscode/.cproject
.vscode/.settings/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# If you use temporary text configurations or local serial logs
*.local
